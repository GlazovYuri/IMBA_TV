{
  "version": 2,
  "groups": [
    {
      "title": "Экраны",
      "help": "Страницы, которые переключаются коротким нажатием кнопки",
      "require_one": true,
      "fields": [
        {
          "key": "screen_charge",
          "type": "bool",
          "default": true,
          "label": "Основной: два крупных значения и заряд колеса"
        },
        {
          "key": "screen_voltage",
          "type": "bool",
          "default": true,
          "label": "Основной: два крупных значения и напряжение колеса"
        },
        {
          "key": "screen_grid",
          "type": "bool",
          "default": true,
          "label": "Сетка из четырёх значений"
        },
        {
          "key": "grid_1",
          "type": "u8",
          "default": 2,
          "label": "Слева сверху",
          "options": [
            { "value": 0, "id": "SPEED", "label": "Скорость, км/ч" },
            { "value": 1, "id": "PWM", "label": "ШИМ, %" },
            { "value": 2, "id": "CHARGE", "label": "Заряд колеса, %" },
            { "value": 3, "id": "VOLTAGE", "label": "Напряжение колеса, В" },
            { "value": 4, "id": "TEMPERATURE", "label": "Температура, °C" },
            { "value": 5, "id": "TRIP", "label": "Пробег, км" }
          ],
          "depends": { "screen_grid": true },
          "subitem": true
        },
        {
          "key": "grid_2",
          "type": "u8",
          "default": 3,
          "label": "Справа сверху",
          "options": [
            { "value": 0, "id": "SPEED", "label": "Скорость, км/ч" },
            { "value": 1, "id": "PWM", "label": "ШИМ, %" },
            { "value": 2, "id": "CHARGE", "label": "Заряд колеса, %" },
            { "value": 3, "id": "VOLTAGE", "label": "Напряжение колеса, В" },
            { "value": 4, "id": "TEMPERATURE", "label": "Температура, °C" },
            { "value": 5, "id": "TRIP", "label": "Пробег, км" }
          ],
          "depends": { "screen_grid": true },
          "subitem": true
        },
        {
          "key": "grid_3",
          "type": "u8",
          "default": 4,
          "label": "Слева снизу",
          "options": [
            { "value": 0, "id": "SPEED", "label": "Скорость, км/ч" },
            { "value": 1, "id": "PWM", "label": "ШИМ, %" },
            { "value": 2, "id": "CHARGE", "label": "Заряд колеса, %" },
            { "value": 3, "id": "VOLTAGE", "label": "Напряжение колеса, В" },
            { "value": 4, "id": "TEMPERATURE", "label": "Температура, °C" },
            { "value": 5, "id": "TRIP", "label": "Пробег, км" }
          ],
          "depends": { "screen_grid": true },
          "subitem": true
        },
        {
          "key": "grid_4",
          "type": "u8",
          "default": 5,
          "label": "Справа снизу",
          "options": [
            { "value": 0, "id": "SPEED", "label": "Скорость, км/ч" },
            { "value": 1, "id": "PWM", "label": "ШИМ, %" },
            { "value": 2, "id": "CHARGE", "label": "Заряд колеса, %" },
            { "value": 3, "id": "VOLTAGE", "label": "Напряжение колеса, В" },
            { "value": 4, "id": "TEMPERATURE", "label": "Температура, °C" },
            { "value": 5, "id": "TRIP", "label": "Пробег, км" }
          ],
          "depends": { "screen_grid": true },
          "subitem": true
        },
        {
          "key": "screen_info",
          "type": "bool",
          "default": true,
          "label": "Связь и версии: задержка и частота данных, версии прошивки и загрузчика"
        },
        {
          "key": "wheel_voltage_x10",
          "type": "u16",
          "default": 1512,
          "label": "Батарея колеса",
          "help": "По максимальному напряжению рассчитывается место под цифры напряжения на экранах",
          "options": [
            { "value": 840, "id": "20S", "label": "84 В (20S)" },
            { "value": 1008, "id": "24S", "label": "100,8 В (24S)" },
            { "value": 1260, "id": "30S", "label": "126 В (30S)" },
            { "value": 1344, "id": "32S", "label": "134,4 В (32S)" },
            { "value": 1512, "id": "36S", "label": "151,2 В (36S)" },
            { "value": 1680, "id": "40S", "label": "168 В (40S)" },
            { "value": 1764, "id": "42S", "label": "176,4 В (42S)" }
          ]
        },
        {
          "key": "main_left",
          "type": "u8",
          "default": 0,
          "section": "Основной экран",
          "label": "Крупное значение слева",
          "options": [
            { "value": 0, "id": "SPEED", "label": "Скорость, км/ч" },
            { "value": 1, "id": "PWM", "label": "ШИМ, %" },
            { "value": 4, "id": "TEMPERATURE", "label": "Температура, °C" }
          ]
        },
        {
          "key": "main_right",
          "type": "u8",
          "default": 1,
          "label": "Крупное значение справа",
          "help": "Число, которое не помещается крупно, выводится шрифтом поменьше",
          "options": [
            { "value": 0, "id": "SPEED", "label": "Скорость, км/ч" },
            { "value": 1, "id": "PWM", "label": "ШИМ, %" },
            { "value": 4, "id": "TEMPERATURE", "label": "Температура, °C" }
          ]
        }
      ]
    },
    {
      "title": "Предупреждение о ШИМ",
      "help": "Мигание экрана, когда ШИМ подходит к пределу",
      "fields": [
        {
          "key": "pwm_alarm",
          "type": "bool",
          "default": true,
          "label": "Мигать экраном при превышении порога ШИМ",
          "help": "Чем выше ШИМ, тем чаще мигание"
        },
        {
          "key": "pwm_alarm_source",
          "type": "u8",
          "default": 0,
          "label": "Порог",
          "options": [
            { "value": 0, "id": "APP", "label": "Из настроек приложения LoEUC" },
            { "value": 1, "id": "FIXED", "label": "Свой" }
          ],
          "depends": { "pwm_alarm": true }
        },
        {
          "key": "pwm_alarm_threshold",
          "type": "u8",
          "default": 80,
          "min": 30,
          "max": 99,
          "unit": "%",
          "label": "Свой порог ШИМ",
          "depends": { "pwm_alarm": true, "pwm_alarm_source": 1 }
        }
      ]
    },
    {
      "title": "Дисплей",
      "help": "Яркость экрана",
      "fields": [
        {
          "key": "brightness",
          "type": "u8",
          "default": 100,
          "min": 5,
          "max": 100,
          "step": 5,
          "unit": "%",
          "widget": "range",
          "label": "Яркость"
        }
      ]
    },
    {
      "title": "Анимации",
      "help": "Заставка при включении и анимация выключения",
      "fields": [
        {
          "key": "intro_logo",
          "type": "bool",
          "default": true,
          "section": "При включении",
          "label": "Логотип при включении",
          "help": "После логотипа играет случайная из отмеченных заставок. Без логотипа данные появляются сразу",
          "preview": "logo"
        },
        {
          "key": "intro_clawd",
          "type": "bool",
          "default": false,
          "label": "Заставки Clawd",
          "help": "Играют заставки Clawd",
          "widget": "clawd",
          "depends": { "intro_logo": true }
        },
        {
          "key": "intro_wave",
          "type": "bool",
          "default": true,
          "label": "Волна",
          "help": "Волна с пузырями проходит слева направо и открывает данные",
          "preview": "wave",
          "depends": { "intro_logo": true, "intro_clawd": false },
          "subitem": true
        },
        {
          "key": "intro_break",
          "type": "bool",
          "default": true,
          "label": "Разрушение",
          "help": "Логотип трескается и рассыпается на куски",
          "preview": "break",
          "depends": { "intro_logo": true, "intro_clawd": false },
          "subitem": true
        },
        {
          "key": "intro_explosion",
          "type": "bool",
          "default": true,
          "label": "Взрыв",
          "help": "Логотип разлетается облаком частиц, как TNT в Minecraft",
          "preview": "explosion",
          "depends": { "intro_logo": true, "intro_clawd": false },
          "subitem": true
        },
        {
          "key": "poweroff_animation",
          "type": "bool",
          "default": true,
          "section": "При выключении",
          "label": "Анимация выключения",
          "help": "Экран сжимается в линию, затем в точку и гаснет, как у старого телевизора",
          "preview": "poweroff"
        }
      ]
    },
    {
      "title": "Кнопка",
      "help": "Сколько держать кнопку, чтобы включить и выключить дисплей",
      "fields": [
        {
          "key": "power_on_ms",
          "type": "u16",
          "default": 500,
          "min": 100,
          "max": 3000,
          "step": 100,
          "unit": "мс",
          "label": "Удержание для включения"
        },
        {
          "key": "power_off_ms",
          "type": "u16",
          "default": 1000,
          "min": 500,
          "max": 5000,
          "step": 100,
          "unit": "мс",
          "label": "Удержание для выключения",
          "help": "Более короткое нажатие переключает экран"
        }
      ]
    },
    {
      "title": "Обновление по Bluetooth",
      "help": "Прошивка с телефона без кабеля",
      "fields": [
        {
          "key": "ble_update",
          "type": "bool",
          "default": true,
          "label": "Разрешить обновление прошивки по Bluetooth",
          "help": "Режим обновления включается, только если при включении держать кнопку ещё 3 секунды после того, как загорится экран, и заряд не ниже 30%. В обычной работе прошить дисплей по Bluetooth нельзя"
        }
      ]
    }
  ]
}
